# =============================================================================
#  Configuración del bot — copia este archivo a .env y rellena tus claves:
#      cp .env.example .env
#  NUNCA subas el .env a git (ya está en .gitignore).
#  Porcentajes en FRACCIÓN: 0.01 = 1 %.
# =============================================================================

# -----------------------------------------------------------------------------
# MODO DE OPERACIÓN
# El flag principal PAPER_TRADING = True está en config.py (modo simulación).
# Para operar con órdenes reales hay que poner PAPER_TRADING = False en
# config.py Y además descomentar esta línea:
# LIVE_TRADING_CONFIRMATION=ACEPTO_EL_RIESGO
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# ALPACA (acciones USA) — https://app.alpaca.markets
# Las claves de la cuenta "Paper" son gratuitas y sirven también para datos
# de mercado y noticias en tiempo real.
# -----------------------------------------------------------------------------
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# true = endpoint paper-api (dinero ficticio). Las claves paper y live son distintas.
ALPACA_PAPER=true
# iex = datos gratuitos | sip = todos los mercados (suscripción de pago)
ALPACA_DATA_FEED=iex
ALPACA_FRACTIONAL=true

# -----------------------------------------------------------------------------
# CRIPTO — binance | kraken
# En PAPER_TRADING no hacen falta claves: se usan datos públicos.
# -----------------------------------------------------------------------------
CRYPTO_EXCHANGE=binance
CRYPTO_API_KEY=
CRYPTO_API_SECRET=
# true = Binance Spot Testnet (solo aplica con PAPER_TRADING = False).
# Kraken no tiene sandbox de spot: con Kraken, false significa DINERO REAL.
CRYPTO_SANDBOX=true

# -----------------------------------------------------------------------------
# NOTICIAS — rss, alpaca, newsapi, alphavantage (se activan si tienen clave)
# -----------------------------------------------------------------------------
NEWS_PROVIDERS=rss,alpaca,newsapi,alphavantage
# https://newsapi.org/register (plan gratuito: 100 peticiones/día, con retardo)
NEWSAPI_KEY=
# https://www.alphavantage.co/support/#api-key (plan gratuito: 25 peticiones/día)
ALPHAVANTAGE_KEY=
# Feeds propios (opcional): url|categoria separados por comas. Categorías: stocks, crypto, macro
# RSS_FEEDS=https://cointelegraph.com/rss|crypto,https://www.cnbc.com/id/100003114/device/rss/rss.html|macro
YAHOO_TICKER_FEEDS=true
RSS_POLL_SECONDS=180
ALPACA_NEWS_POLL_SECONDS=120
NEWSAPI_POLL_SECONDS=900
ALPHAVANTAGE_POLL_SECONDS=3600
NEWS_LOOKBACK_MINUTES=240
SENTIMENT_HALF_LIFE_MINUTES=60

# -----------------------------------------------------------------------------
# WATCHLIST
# -----------------------------------------------------------------------------
STOCK_SYMBOLS=AAPL,MSFT,NVDA,TSLA
# Formato BASE/QUOTE. Todos con la misma divisa de cotización.
# En Kraken suele ser /USD (ej. BTC/USD,ETH/USD)
CRYPTO_SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT

# -----------------------------------------------------------------------------
# ESTRATEGIA
# -----------------------------------------------------------------------------
LOOP_INTERVAL_SECONDS=30
BAR_TIMEFRAME=5m
BARS_LOOKBACK=150
EMA_FAST=9
EMA_SLOW=21
RSI_PERIOD=14
RSI_ENTRY_MIN=50
RSI_ENTRY_MAX=70
ATR_PERIOD=14
VWAP_WINDOW=48
VOLUME_WINDOW=20
MIN_VOLUME_RATIO=1.0
# Score de Trading (-100 a +100) para entrar / forzar salida
ENTRY_SCORE=25
EXIT_SCORE=-20
MIN_ARTICLES=2
NEWS_FRESHNESS_MINUTES=90
MARKET_RISK_OFF_SCORE=-30

# -----------------------------------------------------------------------------
# GESTIÓN DE RIESGO
# -----------------------------------------------------------------------------
# Máximo del saldo por operación (límite duro: no puede superar 0.05)
MAX_POSITION_PCT=0.05
# Pérdida máxima por operación como fracción del capital
MAX_RISK_PER_TRADE_PCT=0.01
# Stop dinámico: ATR x multiplicador, acotado entre MIN_STOP_PCT y STOP_LOSS_PCT
STOP_LOSS_PCT=0.01
MIN_STOP_PCT=0.005
ATR_STOP_MULTIPLIER=2.0
# Take-profit en múltiplos del stop (0 = sin TP fijo, solo trailing)
TAKE_PROFIT_RR=1.5
# Trailing stop: se activa con +1R y persigue al precio a 0.75R
TRAILING_ACTIVATION_R=1.0
TRAILING_DISTANCE_R=0.75
MAX_OPEN_POSITIONS=3
MAX_TOTAL_EXPOSURE_PCT=0.15
MAX_DAILY_LOSS_PCT=0.02
MAX_TRADES_PER_DAY=20
MAX_CONSECUTIVE_LOSSES=3
PAUSE_AFTER_LOSSES_MINUTES=60
SYMBOL_COOLDOWN_MINUTES=15
MAX_HOLDING_MINUTES=180
MAX_SPREAD_PCT=0.002
# Costes estimados (para simular y para el filtro de rentabilidad)
FEE_PCT_STOCKS=0.0
FEE_PCT_CRYPTO=0.001
SLIPPAGE_PCT=0.0005
MIN_EDGE_COST_MULTIPLE=2.0
FLATTEN_MINUTES_BEFORE_CLOSE=10
NO_ENTRIES_MINUTES_BEFORE_CLOSE=30
PDT_PROTECTION=true
KILL_SWITCH_FLATTEN=true
DAILY_RESET_TZ=UTC

# -----------------------------------------------------------------------------
# SIMULACIÓN (PAPER_TRADING = True)
# -----------------------------------------------------------------------------
PAPER_INITIAL_CASH_STOCKS=10000
PAPER_INITIAL_CASH_CRYPTO=10000

# -----------------------------------------------------------------------------
# VARIOS
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
HEARTBEAT_EVERY_CYCLES=10
HTTP_TIMEOUT_SECONDS=10
# LOG_DIR=/ruta/a/logs
# STATE_DIR=/ruta/a/state
